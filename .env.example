# Ozon Assistant local development configuration
# Copy this file to .env. Never commit real credentials.

# FastAPI settings use the OZON_ASSISTANT_ prefix.
OZON_ASSISTANT_APP_NAME=Ozon Assistant API
OZON_ASSISTANT_API_PREFIX=/api/v1
OZON_ASSISTANT_DATABASE_URL=sqlite:///./data/ozon_assistant.db
OZON_ASSISTANT_LOG_LEVEL=INFO
OZON_ASSISTANT_CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost"]

# V1 defaults: keep all integrations in mock mode.
OZON_ASSISTANT_SOURCE_PROVIDER=mock
OZON_ASSISTANT_AI_PROVIDER=mock
OZON_ASSISTANT_AI_MODEL=mock-product-processor-v1
OZON_ASSISTANT_AI_TEMPERATURE=0.2
OZON_ASSISTANT_OZON_MODE=mock

# Vite exposes only VITE_ variables to the desktop frontend.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Reserved for a future real 1688 provider; current V1 mock code does not use these.
OZON_ASSISTANT_SOURCE_APP_KEY=
OZON_ASSISTANT_SOURCE_APP_SECRET=

# Reserved for a future real AI provider; only configure after that provider is implemented.
OZON_ASSISTANT_AI_BASE_URL=
OZON_ASSISTANT_AI_API_KEY=

# Reserved for a future real Ozon connector; V1 mock publishing does not use these.
OZON_ASSISTANT_OZON_CLIENT_ID=
OZON_ASSISTANT_OZON_API_KEY=
OZON_ASSISTANT_OZON_API_BASE_URL=https://api-seller.ozon.ru

# Planned pricing defaults. Confirm the implementation reads them and verify the
# business values before any real pricing decision.
OZON_ASSISTANT_PRICING_CURRENCY=CNY
OZON_ASSISTANT_PRICING_TARGET_CURRENCY=RUB
OZON_ASSISTANT_PRICING_EXCHANGE_RATE=12.50
OZON_ASSISTANT_PRICING_TARGET_MARGIN=0.30
OZON_ASSISTANT_PRICING_PLATFORM_COMMISSION_RATE=0.15
OZON_ASSISTANT_PRICING_PAYMENT_FEE_RATE=0.02
OZON_ASSISTANT_PRICING_RETURN_LOSS_RATE=0.03

