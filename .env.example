# Ozon Assistant local development configuration
# Copy this file to .env. Never commit real credentials.

# FastAPI settings use the OZON_ASSISTANT_ prefix.
OZON_ASSISTANT_APP_NAME=Ozon Assistant API
OZON_ASSISTANT_API_PREFIX=/api/v1
OZON_ASSISTANT_DATABASE_URL=sqlite:///./data/ozon_assistant.db
OZON_ASSISTANT_LOG_LEVEL=INFO
OZON_ASSISTANT_CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost","http://tauri.localhost"]

# Product collection reads real pages; AI and Ozon require separate integrations.
OZON_ASSISTANT_SOURCE_PROVIDER=browser
OZON_ASSISTANT_SOURCE_BROWSER_PROFILE=./data/1688-browser-profile
OZON_ASSISTANT_SOURCE_BROWSER_TIMEOUT_MS=45000
OZON_ASSISTANT_AI_PROVIDER=mock
OZON_ASSISTANT_AI_MODEL=mock-product-processor-v1
OZON_ASSISTANT_AI_TEMPERATURE=0.2
OZON_ASSISTANT_OZON_MODE=mock

# Vite exposes only VITE_ variables to the desktop frontend.
VITE_API_URL=http://127.0.0.1:8001/api/v1

# Reserved for a future official 1688 API; browser collection does not use these.
OZON_ASSISTANT_SOURCE_APP_KEY=
OZON_ASSISTANT_SOURCE_APP_SECRET=

# Real AI provider (OpenAI Compatible). DeepSeek example:
#   OZON_ASSISTANT_AI_PROVIDER=openai_compatible
#   OZON_ASSISTANT_AI_BASE_URL=https://api.deepseek.com
#   OZON_ASSISTANT_AI_MODEL=deepseek-chat
#   OZON_ASSISTANT_AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, local gateways).
# deepseek-reasoner is supported too; JSON mode is skipped automatically.
OZON_ASSISTANT_AI_BASE_URL=
OZON_ASSISTANT_AI_API_KEY=
OZON_ASSISTANT_AI_TIMEOUT_S=60
OZON_ASSISTANT_AI_MAX_RETRIES=2

# Real Ozon Seller API. Get credentials: Ozon Seller portal -> Settings -> Seller API.
#   OZON_ASSISTANT_OZON_MODE=real
#   OZON_ASSISTANT_OZON_CLIENT_ID=123456
#   OZON_ASSISTANT_OZON_API_KEY=xxxxxxxx
# Mock mode never touches the real store. Real publishing always needs human
# confirmation in the draft review page.
OZON_ASSISTANT_OZON_CLIENT_ID=
OZON_ASSISTANT_OZON_API_KEY=
OZON_ASSISTANT_OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_ASSISTANT_OZON_TIMEOUT_S=60

# Image pipeline: downloaded product images are cached here, normalized as JPEG.
# Ozon only accepts PUBLIC image URLs; set MEDIA_PUBLIC_BASE_URL when the cache
# directory is served over HTTP(S) (e.g. via a static file server or CDN).
OZON_ASSISTANT_MEDIA_CACHE_DIR=./data/media
OZON_ASSISTANT_MEDIA_PUBLIC_BASE_URL=

# Pricing defaults used by the deterministic V1 pricing engine. Values are
# loaded by the backend; rates use decimal form (0.16 = 16%).
OZON_ASSISTANT_PRICING_EXCHANGE_RATE=12.50
OZON_ASSISTANT_PRICING_DOMESTIC_SHIPPING=8.00
OZON_ASSISTANT_PRICING_INTERNATIONAL_SHIPPING=24.00
OZON_ASSISTANT_PRICING_OTHER_COSTS=2.00
OZON_ASSISTANT_PRICING_PLATFORM_COMMISSION_RATE=0.16
OZON_ASSISTANT_PRICING_PAYMENT_FEE_RATE=0.02
OZON_ASSISTANT_PRICING_ADVERTISING_RATE=0.08
OZON_ASSISTANT_PRICING_RETURN_LOSS_RATE=0.04
OZON_ASSISTANT_PRICING_TARGET_MARGIN=0.25

