# Copy to backend/.env only when starting commands from the backend directory.
OZON_ASSISTANT_APP_NAME=Ozon Assistant API
OZON_ASSISTANT_API_PREFIX=/api/v1
OZON_ASSISTANT_DATABASE_URL=sqlite:///./data/ozon_assistant.db
OZON_ASSISTANT_LOG_LEVEL=INFO
# JSON array of desktop/webview origins allowed to call the local API on port 8001.
OZON_ASSISTANT_CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","http://tauri.localhost","tauri://localhost"]
OZON_ASSISTANT_SOURCE_PROVIDER=mock
OZON_ASSISTANT_AI_PROVIDER=mock
OZON_ASSISTANT_AI_MODEL=mock-product-processor-v1
OZON_ASSISTANT_AI_TEMPERATURE=0.2
OZON_ASSISTANT_OZON_MODE=mock
# Keep real credentials only in a local .env file. They are never returned by the API.
OZON_ASSISTANT_AI_BASE_URL=
OZON_ASSISTANT_AI_API_KEY=
OZON_ASSISTANT_OZON_CLIENT_ID=
OZON_ASSISTANT_OZON_API_KEY=

# Deterministic pricing defaults. Rates use decimal form (0.16 = 16%).
OZON_ASSISTANT_PRICING_EXCHANGE_RATE=12.50
OZON_ASSISTANT_PRICING_DOMESTIC_SHIPPING=8.00
OZON_ASSISTANT_PRICING_INTERNATIONAL_SHIPPING=24.00
OZON_ASSISTANT_PRICING_OTHER_COSTS=2.00
OZON_ASSISTANT_PRICING_PLATFORM_COMMISSION_RATE=0.16
OZON_ASSISTANT_PRICING_PAYMENT_FEE_RATE=0.02
OZON_ASSISTANT_PRICING_ADVERTISING_RATE=0.08
OZON_ASSISTANT_PRICING_RETURN_LOSS_RATE=0.04
OZON_ASSISTANT_PRICING_TARGET_MARGIN=0.25

